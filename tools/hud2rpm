#!/bin/bash
# hud2rpm - convert a HUD package (.hud tarball) into an RPM.
#
#   hud2rpm <file.hud> [name] [version]
#   hud2rpm --from-list <packages.list> <repo-url>    convert a whole hud repo
#
# A .hud file is a gzip tarball whose members are absolute-ish paths rooted at /
# (in practice everything under opt/hud/).  The conversion keeps that layout, so a
# converted package installs to exactly where hud would have put it -- meaning the
# switch to dnf changes the bookkeeping, not the files on disk.
#
# Dependency metadata comes from the pipe-delimited packages.list row when
# available:  name|version|arch|filename|size|sha256|depends|section|service
set -u

C_G='\033[0;32m'; C_R='\033[0;31m'; C_C='\033[0;36m'; C_N='\033[0m'
msg() { echo -e "${C_C}==>${C_N} $*"; }
die() { echo -e "${C_R}error:${C_N} $*" >&2; exit 1; }

TOP="${HOME}/rpmbuild"
install -d "$TOP"/{SPECS,SOURCES,BUILD,BUILDROOT,RPMS,SRPMS}

convert_one() {
    local hud="$1" name="$2" ver="$3" deps="${4:-}" section="${5:-}" svc="${6:-}"
    [ -f "$hud" ] || die "no such file: $hud"

    local work; work=$(mktemp -d)
    trap 'rm -rf "$work"' RETURN
    tar -xzf "$hud" -C "$work" || die "cannot extract $hud (is it a gzip tarball?)"

    # Turn hud's comma/space separated dep string into rpm Requires: lines.
    local reqs=""
    if [ -n "$deps" ]; then
        local d
        for d in $(echo "$deps" | tr ',;' '  '); do
            [ -n "$d" ] && reqs+="Requires:       hud-${d}"$'\n'
        done
    fi

    local spec="$TOP/SPECS/hud-${name}.spec"
    cat > "$spec" <<EOF
# Generated by hud2rpm from ${hud##*/} -- regenerate rather than hand-editing.
%global __brp_check_rpaths %{nil}
%global debug_package %{nil}
%define _build_id_links none

Name:           hud-${name}
Version:        ${ver}
Release:        1%{?dist}
Summary:        ${name} (converted from HUD package)
License:        Unknown
URL:            https://blackflag.com.bd
BuildArch:      x86_64
Group:          ${section:-Applications/System}

Provides:       hud(${name}) = ${ver}
${reqs}
%description
${name} ${ver}, converted from the HUD package ${hud##*/} by hud2rpm.
Files keep their original /opt/hud prefix, so this package is a drop-in
replacement for the hud-installed copy.

%prep
%build
%install
mkdir -p %{buildroot}
cp -a ${work}/. %{buildroot}/ 2>/dev/null || :
find %{buildroot} -type d -empty -delete 2>/dev/null || :

%files
$( cd "$work" && find . \( -type f -o -type l \) -printf '/%P\n' | sed 's/[[:space:]]/\\&/g' )

%changelog
* $(LC_ALL=C date '+%a %b %d %Y') hud2rpm <build@blackflag.com.bd> - ${ver}-1
- Automatic conversion from HUD package format
EOF

    msg "building hud-${name}-${ver}"
    rpmbuild -bb "$spec" >/dev/null 2>&1 \
        || { rpmbuild -bb "$spec" 2>&1 | tail -20; die "rpmbuild failed for $name"; }
    echo -e "${C_G} ok ${C_N} $(ls -t "$TOP"/RPMS/*/hud-${name}-${ver}*.rpm | head -1)"
}

if [ "${1:-}" = "--from-list" ]; then
    list="${2:?need packages.list}"; base="${3:?need repo base url}"
    while IFS='|' read -r n v a file size sha deps sect svc; do
        case "$n" in ''|\#*) continue;; esac
        local_tb="/tmp/hud2rpm-$n-$v.hud"
        msg "fetching $n $v"
        curl -fsSL -o "$local_tb" "${base%/}/${file}" || { echo "  skip (download failed)"; continue; }
        convert_one "$local_tb" "$n" "$v" "$deps" "$sect" "$svc"
        rm -f "$local_tb"
    done < "$list"
    exit 0
fi

hud="${1:?usage: hud2rpm <file.hud> [name] [version]  |  hud2rpm --from-list <packages.list> <url>}"
bn=$(basename "$hud" .hud)
name="${2:-$(echo "$bn" | sed -E 's/-[0-9].*$//')}"
ver="${3:-$(echo "$bn"  | sed -E 's/^.*-([0-9][^-]*).*$/\1/')}"
[ -n "$ver" ] || ver=0
convert_one "$hud" "$name" "$ver"

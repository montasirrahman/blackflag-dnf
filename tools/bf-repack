#!/bin/bash
# bf-repack - turn an already-built source tree into an RPM, without recompiling.
#
#   bf-repack <name> <version> <build-dir> [install-command...]
#
# The bootstrap installs rpm, dnf5 and their libraries straight into /usr, because
# there is no package manager yet to install them properly.  That leaves the
# package manager itself unmanaged: dnf cannot update dnf.
#
# This closes that gap.  The build trees are still on disk and already compiled,
# so re-running their install step with DESTDIR pointed at a buildroot costs
# seconds rather than a rebuild.  The resulting file list becomes %files, rpm
# generates Provides/Requires from the binaries as usual, and the bootstrap stack
# becomes ordinary RPM content that dnf can upgrade.
#
# The install command may contain the token @BUILDROOT@, which is replaced with the
# staging directory.  Use it for build systems that honour neither DESTDIR nor a
# separate prefix at install time -- bzip2's Makefile, for instance, has no DESTDIR
# support at all:
#     bf-repack bzip2 1.0.8 <dir> make install "PREFIX=@BUILDROOT@/usr"
#
# BF_REPACK_EXCLUDE may hold whitespace-separated globs (rooted at /) to drop from
# the package before %files is generated.  Use it for optional components whose
# dependencies are not installed -- git-svn needs perl(SVN::Core), git-p4 needs
# /usr/bin/python.  Upstream distributions solve this by splitting those into
# subpackages; excluding them is the same decision without the subpackage.
#
# Examples:
#   bf-repack rpm 4.19.1.1 /root/blackflag/build/rpm-4.19.1.1 make -C _build install
#   BF_REPACK_EXCLUDE="/usr/libexec/git-core/git-svn" bf-repack git ...
set -eu

name="${1:?usage: bf-repack <name> <version> <build-dir> [install-command...]}"
ver="${2:?need version}"
dir="${3:?need build dir}"
shift 3
INSTALL_CMD=("$@")
[ ${#INSTALL_CMD[@]} -gt 0 ] || INSTALL_CMD=(make install)

[ -d "$dir" ] || { echo "no such build dir: $dir" >&2; exit 1; }

TOP="${HOME}/rpmbuild"
mkdir -p "$TOP"/{SPECS,SOURCES,BUILD,BUILDROOT,RPMS,SRPMS}
BR=$(mktemp -d "/var/tmp/bf-repack-${name}-XXXXXX")

# GNU make ranks variable sources: command line > makefile > environment.  A
# Makefile containing a bare "DESTDIR =" -- readline and many hand-written ones do
# -- therefore OVERRIDES a DESTDIR taken from the environment, and `make install`
# writes straight into /usr instead of the staging directory.  Passing it as a
# command-line argument outranks the makefile and is the only reliable way.
# Environment is kept as well, for ninja and cmake install scripts, which read it
# from there and take no make-style arguments.
INSTALL_ARGS=()
for a in "${INSTALL_CMD[@]}"; do INSTALL_ARGS+=("${a//@BUILDROOT@/$BR}"); done
case "${INSTALL_ARGS[0]}" in
    make|gmake) INSTALL_ARGS+=("DESTDIR=$BR") ;;
esac

# Tripwire.  Compare ctime, not mtime: an install that preserves timestamps
# (install -p, cp -p) can write a file whose mtime is older than the marker, but
# ctime is set by the kernel on write and cannot be forged.
MARKER=$(mktemp); trap 'rm -rf "$BR" "$MARKER"' EXIT

echo "==> staging install into $BR"
( cd "$dir" && DESTDIR="$BR" "${INSTALL_ARGS[@]}" ) >/dev/null 2>&1 \
    || { cd "$dir" && DESTDIR="$BR" "${INSTALL_ARGS[@]}" 2>&1 | tail -20; exit 1; }

GUARD_DIRS="${BF_REPACK_GUARD_DIRS:-/usr /etc /bin /sbin /lib /lib64 /opt}"
leaked=$(find $GUARD_DIRS -xdev \( -type f -o -type l \) \
             -newercm "$MARKER" 2>/dev/null \
         | grep -vE '^/usr/lib/sysimage/|^/etc/ld\.so\.cache$' | head -40)
if [ -n "$leaked" ]; then
    echo "" >&2
    echo "REFUSING TO CONTINUE: the install wrote OUTSIDE the staging directory." >&2
    echo "The live system has been modified by '${INSTALL_CMD[*]}':" >&2
    echo "$leaked" | sed 's/^/    /' >&2
    echo "" >&2
    echo "This build system ignores DESTDIR.  Re-run with an explicit staging" >&2
    echo "prefix, e.g.  ... make install \"PREFIX=@BUILDROOT@/usr\"" >&2
    echo "Restore the listed paths before retrying." >&2
    exit 2
fi

# libtool archives and static libs are build-time leftovers; they bloat packages
# and .la files actively break later builds by hardcoding paths.
find "$BR" -name '*.la' -delete 2>/dev/null || true

for pat in ${BF_REPACK_EXCLUDE:-}; do
    for victim in "$BR"${pat}; do
        [ -e "$victim" ] || continue
        rm -rf "$victim" && echo "    excluded: ${victim#$BR}"
    done
done

count=$(find "$BR" \( -type f -o -type l \) | wc -l)
[ "$count" -gt 0 ] || { echo "install produced no files - wrong install command?" >&2; exit 1; }
echo "    $count files"

spec="$TOP/SPECS/${name}.spec"
{
cat <<EOF
# Generated by bf-repack from the bootstrap build tree at
#   $dir
# Regenerate rather than hand-editing; see tools/bf-repack.
%global debug_package %{nil}
%global __brp_check_rpaths %{nil}
%define _build_id_links none

Name:           ${name}
Version:        ${ver}
Release:        1%{?dist}
Summary:        ${name} ${ver} (repackaged from the BlackFlag bootstrap build)
License:        See the upstream source
URL:            https://blackflag.com.bd

%description
${name} ${ver}, packaged from the tree the BlackFlag DNF bootstrap already built.
The binaries are byte-for-byte the ones installed by the bootstrap; this package
exists so that dnf can own, verify and upgrade them like anything else.

%install
mkdir -p %{buildroot}
cp -a ${BR}/. %{buildroot}/

%files
EOF
# Emit the file list.  Three things need care:
#   - rpm's own % must be escaped, and so must whitespace in filenames
#   - rpm's brp-compress build-root policy gzips man and info pages during
#     %install, so a list captured from DESTDIR names files that no longer
#     exist by the time %files is processed.  Appending * to those paths is
#     the same idiom hand-written specs use, and for the same reason.
( cd "$BR" && find . \( -type f -o -type l \) -printf '/%P\n' ) \
    | sed -e 's/%/%%/g' -e 's/[[:space:]]/\\&/g' \
          -e '\#^/usr/share/\(man\|info\)/#s/$/*/' \
    | sort -u
cat <<EOF

%changelog
* $(LC_ALL=C date '+%a %b %d %Y') BlackFlag Build System <build@blackflag.com.bd> - ${ver}-1
- Repackaged from the bootstrap build tree
EOF
} > "$spec"

echo "==> rpmbuild"
rpmbuild -bb "$spec" >/dev/null 2>&1 \
    || { rpmbuild -bb "$spec" 2>&1 | tail -25; exit 1; }

out=$(ls -t "$TOP"/RPMS/*/"${name}"-"${ver}"-*.rpm 2>/dev/null | head -1)
echo "==> $out"
rpm -qp --qf '    provides: %{PROVIDES}\n' "$out" 2>/dev/null | head -3 || true
